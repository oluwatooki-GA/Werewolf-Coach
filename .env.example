# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Needed from M2 (real agents)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Free tiers, smoke tests and E9 (M2 and M6)
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Needed when Postgres arrives
DATABASE_URL=

# Langfuse traces of every model call (all three, or none)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# The site's play mode (docker compose and Render read these). Empty PLAY_MODEL turns play off;
# `fake` plays free scripted games; otherwise it is the model the agents use, such as gpt-4o-mini.
PLAY_MODEL=
PLAY_GAME_BUDGET=0.40
PLAY_GAME_ESTIMATE=0.30
PLAY_DAILY_CAP=1.00
PLAY_TOTAL_CAP=10.00

# Opens /metrics and the admin page. Make it long and random; empty means neither exists.
ADMIN_TOKEN=
